# =============================================================================
# Hermes Money-Maker Profile — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# REAL VALUES MUST NOT BE COMMITTED TO GIT.
# =============================================================================

# Hermes profile directory
HERMES_PROFILE=money-maker

# Provider API Keys (REQUIRED)
ARK_API_KEY=your-ark-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
XIAOMI_API_KEY=your-xiaomi-mimo-api-key-here
OPENCODE_GO_API_KEY=your-opencode-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
CCSUB_API_KEY=your-ccsub-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
SCNET_API_KEY=your-scnet-api-key-here

# Default model
HERMES_DEFAULT_MODEL=mimo-v2.5-pro

# Platform credentials
WEIXIN_TOKEN=your-weixin-token
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
WEBHOOK_SECRET=your-webhook-secret

# Tavily search
TAVILY_API_KEY=your-tavily-api-key

# Cron-specific (for 具身智能每日市场扫描)
FEISHU_CHAT_ID=your-feishu-chat-id
